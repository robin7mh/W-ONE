{
  "name": "w-one-ui",
  "version": "0.1.0",
  "description": "W-ONE — a dark, futuristic Sci-Fi command-center desktop UI (UI-only phase).",
  "author": "W-ONE",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "node scripts/fix-node-pty.cjs && electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.20",
    "@fontsource/jetbrains-mono": "^5.0.20",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.11.1",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "framer-motion": "^11.3.19",
    "ignore": "^5.3.2",
    "lucide-react": "^0.427.0",
    "marked": "^18.0.14",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.33.15",
    "yaml": "^2.9.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.14.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^37.10.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  }
}
