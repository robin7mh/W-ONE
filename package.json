{
  "name": "w-one",
  "version": "0.1.0",
  "description": "W-ONE — a dark, futuristic Sci-Fi command-center desktop app.",
  "author": "Robin Hinkelmann",
  "license": "SEE LICENSE IN LICENSE",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node --max-old-space-size=4096 node_modules/electron-vite/bin/electron-vite.js build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --config vite.web.config.ts",
    "server:build": "vite build --config vite.server.config.ts",
    "server": "node out/server/index.cjs",
    "server:pair": "node out/server/index.cjs pair",
    "web": "npm run web:build && npm run server:build && npm run server",
    "postinstall": "node scripts/fix-node-pty.cjs",
    "predev": "docker compose up -d --wait db || echo [db] Docker is not running - W-ONE starts without its database",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker exec -it w-one-db psql -U wone -d wone",
    "db:backup": "node scripts/db-backup.cjs",
    "docker:build": "docker build -t ghcr.io/robin7mh/w-one:local .",
    "docker:up": "docker compose --profile core up -d --build --wait",
    "docker:pair": "docker exec w-one-core node out/server/index.cjs pair",
    "docker:logs": "docker compose logs -f core",
    "docker:down": "docker compose --profile core down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run web:build && npm run server:build && npm run db:up && playwright test",
    "test:all": "npm run typecheck && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/inter": "^5.0.20",
    "@fontsource/jetbrains-mono": "^5.0.20",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "framer-motion": "^11.3.19",
    "ignore": "^5.3.2",
    "lucide-react": "^0.427.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.33.15",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.14.14",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.19",
    "electron": "^37.10.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^26.1.0",
    "pg-mem": "^3.0.14",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vitest": "^3.2.7"
  }
}
