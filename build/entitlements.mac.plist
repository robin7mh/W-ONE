<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The main app (hardened runtime, required for notarization). V8 needs JIT (MAP_JIT: allow-jit — not
     allow-unsigned-executable-memory, which Electron no longer needs).
     disable-library-validation: the same binary runs the project's own ESLint and Prettier with their
     plugins as Node (the lint worker, ELECTRON_RUN_AS_NODE) — and those may load native addons from the
     project (unrs-resolver, @swc/core …) that are not signed with Mindeck's team ID. Mindeck's own native
     modules (node-pty, ssh2, cpu-features) are signed with the app and would not need it.
     Camera and microphone: websites in Mindeck's browser may ask for them (video calls, recordings) —
     macOS still asks the user once, with the texts in electron-builder.yml (extendInfo).
     The helper apps (renderer, GPU, plugin) get entitlements.mac.inherit.plist: JIT only. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
