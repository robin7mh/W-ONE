# Copy to .env to change the defaults. Everything works without it.
# docker-compose.yml reads these; the app reads the WONE_* ones directly.
WONE_DB_USER=wone
WONE_DB_PASSWORD=wone
WONE_DB_NAME=wone
WONE_DB_PORT=54329
WONE_DB_URL=postgres://wone:wone@127.0.0.1:54329/wone

# W-ONE core in Docker (npm run docker:up)
WONE_CORE_PORT=7420
# 0.0.0.0 = reachable from other devices on your network (phone). Pairing protects it.
WONE_BIND=127.0.0.1
# Folder on the host whose sub-folders the core may add as projects (/projects inside).
# WONE_PROJECTS_DIR=~/Projects
# Let paired devices open real shells (0/1). Off by default.
WONE_REMOTE_TERMINAL=0
# LLM key for the assistant (can also be set in Settings → AI).
# ANTHROPIC_API_KEY=

# Standalone core without Docker (npm run web / npm run server)
# WONE_PORT=7420
# WONE_LAN=1

# Everything W-ONE stores (vault, settings, projects, devices) lives here:
# WONE_HOME=~/W-ONE
