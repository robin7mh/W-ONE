# Copy to .env to change the local database. The defaults work as-is.
# docker-compose.yml reads these; the app reads WONE_DB_URL.
WONE_DB_USER=wone
WONE_DB_PASSWORD=wone
WONE_DB_NAME=wone
WONE_DB_PORT=54329
WONE_DB_URL=postgres://wone:wone@127.0.0.1:54329/wone

# Everything else W-ONE stores (vault, settings, projects) lives here:
# WONE_HOME=~/W-ONE
